+// Compatibility shim mapping the old @faker-js/faker@5.x API (used by this
+// file's dynamic-variables.js) onto @faker-js/faker@10.x's renamed modules.
+//
+// This exists because postman-collection pins @faker-js/faker to 5.5.3,
+// which is affected by CVE-2026-73231 (arbitrary code execution via
+// faker.helpers.fake). The real fix requires faker >=10.5.0, but that
+// release renamed/removed the modules this file calls directly
+// (faker.address -> faker.location, faker.name -> faker.person, etc).
+// See patches/postman-collection+<version>.patch for how this file is wired in.
+
+var faker = require('@faker-js/faker').faker;
+
+module.exports = {
+    address: {
+        city: faker.location.city,
+        country: faker.location.country,
